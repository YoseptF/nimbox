{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "nimbox-mail" }],
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "UPDATER", "class_name": "Updater" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailbox", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Updater"] }
  ]
}
